NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# for local supabase development only
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
AZURE_CLIENT_ID=
AZURE_SECRET=

NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_NAME=

# Optional — rate limiting on election creation, voting, and public results
# polling no-ops without these (safe for local dev/CI). Required in
# production. Get these from an Upstash Redis database (upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# could either be production of development
NODE_ENV=